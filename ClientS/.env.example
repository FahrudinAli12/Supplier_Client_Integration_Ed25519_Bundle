# Client app must point to the CLIENT Supabase project.
SUPABASE_URL=https://YOUR_CLIENT_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_CLIENT_PUBLISHABLE_OR_ANON_KEY
SUPABASE_PUBLISHABLE_KEY=YOUR_CLIENT_PUBLISHABLE_KEY

# Keep disabled until SQL migration, Edge Function, and tenant tests all pass.
ENABLE_PACKAGE_RECEIVING_API=0
