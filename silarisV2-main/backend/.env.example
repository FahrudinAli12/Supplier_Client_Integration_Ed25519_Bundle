# === ONE SHARED SUPABASE PROJECT (Supplier + Client) ===
SUPABASE_URL=https://bgtxpdydljfeltdimmxr.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Deprecated compatibility variables. Leave blank or set to the exact same project.
SUPABASE_ANON_KEY=
CLIENT_SUPABASE_URL=
CLIENT_SUPABASE_PUBLISHABLE_KEY=

# === Supplier Ed25519 device identity ===
CLIENT_SUPPLIER_DEVICE_ID=SILARIS-SUPPLIER-DEVICE-01
# 32-byte raw private key as 64 hex characters. Keep this secret in backend .env only.
CLIENT_SUPPLIER_PRIVATE_KEY_HEX=

# === Supplier Auth session cookie ===
# false for local HTTP; true only when serving the app over HTTPS.
SUPPLIER_SESSION_COOKIE_SECURE=false
SUPPLIER_SESSION_MAX_AGE_SECONDS=2592000

# === Serial / RFID ===
ALLOWED_DRIVERS=cp210

# === Sync Worker ===
SYNC_LOOP_INTERVAL_SECONDS=30
SYNC_MAX_RETRY_BEFORE_PERMANENT_FAIL=10

# === HTTP Timeouts ===
HTTPX_TIMEOUT_SYNC_SECONDS=10
HTTPX_TIMEOUT_ADMIN_SECONDS=15

# === Local SQLite ===
DATABASE_URL=sqlite:///./local.db
